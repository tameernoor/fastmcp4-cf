{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fastmcp4-cf",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "observability": { "enabled": true },

  // ACCESS_TEAM_DOMAIN and ACCESS_AUD are deliberately NOT here — they point
  // at one specific Zero Trust org, so a committed value would send every
  // clone at someone else's account. Set them per-deployment instead:
  //
  //   local:    .dev.vars            (gitignored; see .dev.vars.example)
  //   deployed: wrangler secret put  (`.env` does NOT reach a deployment —
  //                                   it is local-dev only)
  //
  // Unset = the server runs with NO authentication and says so on boot.
  // See AUTH.md.

  // The Python image. wrangler builds this Dockerfile and pushes it to
  // Cloudflare's registry on deploy.
  // Must match INSTANCES in src/index.ts — every request, either protocol era,
  // is load-balanced across this pool with no affinity.
  "containers": [
    {
      "class_name": "FastMCPContainer",
      "image": "./Dockerfile",
      "max_instances": 3
    }
  ],

  // Containers are addressed through a Durable Object binding.
  "durable_objects": {
    "bindings": [
      {
        "name": "MCP_CONTAINER",
        "class_name": "FastMCPContainer"
      }
    ]
  },

  // Note new_sqlite_classes, not new_classes — required for Container classes.
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["FastMCPContainer"]
    }
  ]
}
